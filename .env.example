# AWS Amplify Deployment
# Set _LIVE_UPDATES in Amplify Console → Build settings → Environment variables:
#   [{"pkg":"node","type":"nvm","version":"20"}]
# All variables below must be set in Amplify Console → App Settings → Environment Variables
# Variables without NEXT_PUBLIC_ prefix are server-side only.

# Database
DATABASE_URL="postgresql://admin:admin@localhost:5432/luxemoon?schema=public"
LOCAL_DATABASE_URL="postgresql://admin:admin@localhost:5432/luxemoon?schema=public"
SUPABASE_DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="https://www.luxemoonbeauty.com"
NEXT_PUBLIC_APP_ENV="development"
NEXT_DIST_DIR=".next"

# Admin Authentication
JWT_SECRET="your-secure-random-secret-here"
ADMIN_EMAIL="admin@luxemoonbeauty.com"
ADMIN_PASSWORD="change-me-in-production"

# Email Notifications (Optional)
RESEND_API_KEY=""

# SMS Notifications (Optional)
SPARROW_SMS_TOKEN=""

# Cloudinary (Media Storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
